# Backend configuration (export these in the environment before starting uvicorn).

# Storage
CUTOUT_DATA_DIR=./data
CUTOUT_CACHE_DIR=./data/jobs
JOB_TTL_HOURS=48

# Usage limits
GUEST_DAILY_LIMIT=2
GUEST_MAX_DIMENSION=1024
MAX_CONCURRENT_JOBS=2
PRELOAD_MODELS=

# Web
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Auth
PBKDF2_ITERATIONS=210000
SESSION_DAYS=30

# Billing
# Set to false once Stripe keys and prices are configured.
CUTOUT_DEV_BILLING=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
